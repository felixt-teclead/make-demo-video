# vc-v1 settings (C-21). Copy to settings.env (git-ignored) and adjust. KEY=VALUE, no quotes.
# Relative paths are relative to the repo root; a leading ~ means the invoking user's home.
VC_PROJECT=vc-v1
VC_CONTAINER_NAME=vc-v1-recorder
VC_IMAGE=vc-v1-recorder:latest
VC_BIND=127.0.0.1
VC_CONTROL_PORT=7811
VC_VNC_PORT=6811
VC_CPUSET=8-15
VC_UID=1000
VC_GID=1000
VC_LOCALE=de_DE.UTF-8
VC_LANG=de-DE
VC_TZ=Europe/Berlin
VC_SCREEN=1920x1080
VC_FPS=30
VC_CRF=18
VC_ENV_FILE=~/.config/vc-v1/env
VC_RUNS_DIR=runs
VC_STATE_DIR=state
